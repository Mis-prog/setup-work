# Copy to .env and fill in what you need. setup-work does not read this file itself;
# load it into your shell explicitly:  set -a; . ./.env; set +a
# Never commit .env (it is git-ignored).

# Hugging Face: access to gated/private repos and cache location.
HF_TOKEN=
# HF_HOME=/data/$USER/hf
# HF_HUB_CACHE=/data/$USER/hf/hub
# HF_ENDPOINT=https://hf-mirror.example.com

# Optional: separate model cache just for setup-work.
# SETUP_WORK_MODEL_CACHE=/data/models

# API key required by `make serve` endpoints (passed via file/env, never argv).
SETUP_WORK_API_KEY=

# Point OpenAI-compatible harnesses (qwen-code, codex, aider, ...) at a local server.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Corporate network.
# HTTPS_PROXY=http://proxy.example.com:3128
# HTTP_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1

# Install locations (defaults shown).
# SETUP_WORK_BIN_DIR=$HOME/.local/bin
# XDG_DATA_HOME=$HOME/.local/share
# XDG_STATE_HOME=$HOME/.local/state
