# Скопируйте в .env и заполните нужные значения. Файл не читается автоматически;
# загрузите его в текущий shell явно:  set -a; . ./.env; set +a
# Не добавляйте .env в Git: файл исключён через .gitignore.

# Каталог распаковки моделей; по умолчанию <data>/models.
# SETUP_WORK_MODEL_DIR=/data/models

# Ключ API сервера make serve; передаётся через файл или окружение, без argv.
SETUP_WORK_API_KEY=

# Адрес локального API и ключи для совместимых харнессов.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Корпоративная сеть.
# HTTPS_PROXY=http://proxy.example.com:3128
# HTTP_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1

# Каталоги установки; ниже значения по умолчанию.
# SETUP_WORK_BIN_DIR=$HOME/.local/bin
# XDG_DATA_HOME=$HOME/.local/share
# XDG_STATE_HOME=$HOME/.local/state
