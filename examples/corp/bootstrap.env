# Читается scripts/bootstrap.sh ДО появления Python (stage 0).
# Только строки KEY=VALUE; ничего не исполняется; секреты запрещены.
# Переменные, уже заданные в окружении пользователя, не перезаписываются.

# Взять uv из корпоративного PyPI (pip install --user uv==<pin>) вместо GitHub:
SETUP_WORK_UV_FROM_PIP=1
# ...или из HDFS (официальный tarball, sha256 проверяется по закреплённому значению):
# SETUP_WORK_UV_ARCHIVE=hdfs:///ml/tools/uv/uv-0.12.13-x86_64-unknown-linux-gnu.tar.gz

# Корпоративные PyPI и npm: setup-work сам пишет ~/.config/pip/pip.conf и ~/.npmrc
# (права 600, остальные настройки в файлах сохраняются). Токены читаются из файлов,
# не печатаются и не попадают в командную строку. `~/` и `$HOME/` в путях раскрываются.
SETUP_WORK_PYPI_INDEX=https://repo.corp.example/repo/pypi/simple
SETUP_WORK_PYPI_USER=token
SETUP_WORK_PYPI_AUTH_FILE=~/nfs/token.txt
SETUP_WORK_PYPI_TRUSTED_HOST=repo.corp.example
SETUP_WORK_NPM_REGISTRY=https://repo.corp.example/repo/npm/
SETUP_WORK_NPM_AUTH_FILE=~/nfs/tokens/npm-token-base64.txt
# SETUP_WORK_NPM_CAFILE=/etc/pki/tls/certs/corp-ca-bundle.crt
SETUP_WORK_NPM_STRICT_SSL=false

# Вместо этого можно запускать свои скрипты до `uv sync` (через двоеточие, абсолютные
# пути, запускаются через sh):
# SETUP_WORK_PRE_SCRIPTS=/opt/corp/bin/setup-pypi.sh:/opt/corp/bin/setup-npm.sh
# UV_PYTHON_INSTALL_MIRROR=https://artifactory.corp.example/python-build-standalone
