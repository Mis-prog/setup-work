# Читается scripts/bootstrap.sh ДО появления Python (stage 0).
# Только строки KEY=VALUE; ничего не исполняется; секреты запрещены.
# Переменные, уже заданные в окружении пользователя, не перезаписываются.

# Взять uv из корпоративного PyPI (pip install --user uv==<pin>) вместо GitHub:
SETUP_WORK_UV_FROM_PIP=1
# ...или из HDFS (официальный tarball, sha256 проверяется по закреплённому значению):
# SETUP_WORK_UV_ARCHIVE=hdfs:///ml/tools/uv/uv-0.12.13-x86_64-unknown-linux-gnu.tar.gz

# Корпоративные скрипты, которые нужно запустить до `uv sync` (через двоеточие):
SETUP_WORK_PRE_SCRIPTS=/opt/corp/bin/setup-pypi.sh:/opt/corp/bin/setup-npm.sh

# Если pip.conf ещё не настроен, индекс можно задать явно:
# UV_DEFAULT_INDEX=https://nexus.corp.example/repository/pypi/simple
# UV_PYTHON_INSTALL_MIRROR=https://artifactory.corp.example/python-build-standalone
