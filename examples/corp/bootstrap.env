# config/bootstrap.env — корпоративные PyPI и npm.
# Только строки KEY=VALUE; ничего не исполняется; токены сюда не пишутся (только пути
# к файлам с ними). Переменные, уже заданные в окружении, не перезаписываются.
# Применить: make registries (или make setup).

# PyPI -> registries/pip.conf (права 600)
SETUP_WORK_PYPI_INDEX=https://repo.corp.example/repo/pypi/simple
SETUP_WORK_PYPI_USER=token
SETUP_WORK_PYPI_AUTH_FILE=~/nfs/tokens/pypi-token.txt   # храните токены на NFS
SETUP_WORK_PYPI_TRUSTED_HOST=repo.corp.example

# npm -> registries/npmrc (права 600, остальные настройки сохраняются)
SETUP_WORK_NPM_REGISTRY=https://repo.corp.example/repo/npm/
SETUP_WORK_NPM_AUTH_FILE=~/nfs/tokens/npm-token-base64.txt
# SETUP_WORK_NPM_CAFILE=/etc/pki/tls/certs/corp-ca-bundle.crt
SETUP_WORK_NPM_STRICT_SSL=false
# другие ключи .npmrc через пробел (save-exact — версии в package.json без ^ и ~)
SETUP_WORK_NPM_OPTIONS="audit=false always-auth=true fetch-retries=5 save-exact=true"
