# PyPI, npm и первая установка uv — редактируйте этот файл.
# Адреса и пути ниже примерные: замените CHANGE-ME и пути к файлам с токенами.
# Из корня репозитория перед make registries / make bootstrap:
#   export SETUP_WORK_USER_CONFIG_DIR="$PWD/config"
# Формат: KEY=VALUE; shell-команды и подстановка переменных здесь не исполняются.
# Секреты не вставляйте: AUTH_FILE содержит только путь к отдельному файлу.
# Если реестр без аутентификации, задайте соответствующий AUTH_FILE пустым.

# ---- Корпоративный PyPI: pip и uv --------------------------------------------
SETUP_WORK_PYPI_INDEX=https://CHANGE-ME-repo-host/repository/pypi-group/simple
SETUP_WORK_PYPI_USER=token
SETUP_WORK_PYPI_AUTH_FILE=~/nfs/tokens/pypi-token.txt

# Для корпоративного CA укажите реальные пути (для первого bootstrap — здесь).
# PIP_CERT=/etc/pki/tls/certs/corp-ca-bundle.crt
# SSL_CERT_FILE=/etc/pki/tls/certs/corp-ca-bundle.crt
# SETUP_WORK_PYPI_TRUSTED_HOST=CHANGE-ME-repo-host

# ---- Корпоративный npm -------------------------------------------------------
SETUP_WORK_NPM_REGISTRY=https://CHANGE-ME-repo-host/repository/npm-group/
# Файл с готовым токеном для _authToken; содержимое используется как есть.
SETUP_WORK_NPM_AUTH_FILE=~/nfs/tokens/npm-token.txt
SETUP_WORK_NPM_STRICT_SSL=true
# SETUP_WORK_NPM_CAFILE=/etc/pki/tls/certs/corp-ca-bundle.crt
SETUP_WORK_NPM_OPTIONS="audit=false fetch-retries=5 save-exact=true"

# ---- uv, если его ещё нет ----------------------------------------------------
# Установка закреплённой проектом версии из указанного выше PyPI.
SETUP_WORK_UV_FROM_PIP=1
# Альтернатива — готовый архив из HDFS; если задан, имеет приоритет над PyPI.
# SETUP_WORK_UV_ARCHIVE=hdfs:///ml/tools/uv/uv-0.12.13-x86_64-unknown-linux-gnu.tar.gz
# SETUP_WORK_HDFS_CLI=/opt/hadoop/bin/hdfs

# ---- Прокси, если нужен ------------------------------------------------------
# HTTPS_PROXY=http://CHANGE-ME-proxy-host:3128
# HTTP_PROXY=http://CHANGE-ME-proxy-host:3128
# NO_PROXY=localhost,127.0.0.1,CHANGE-ME-repo-host,CHANGE-ME-bitbucket-host
